{"nodes": [{"id": "docs_realtime_transport_map", "label": "SmartIDS Realtime Transport Map", "file_type": "document", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_hybrid_transport_model", "label": "Hybrid Transport Model", "file_type": "rationale", "rationale": "SmartIDS uses WebSockets for event streams, WebSocket+polling for dashboard aggregates, on-demand fetch for details, server-rendered fetch for initial page data, and polling for engine command intake -- not a polling-only or WebSocket-only app.", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_websocket_transport", "label": "WebSocket Transport", "file_type": "concept", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_polling_transport", "label": "Polling Transport", "file_type": "concept", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_on_demand_fetch", "label": "On-Demand Fetch Transport", "file_type": "concept", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_server_rendered_fetch", "label": "Server-Rendered Fetch Transport", "file_type": "concept", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_duplicated_dashboard_realtime_issue", "label": "Duplicated useDashboardRealtime Subscriptions Issue", "file_type": "rationale", "rationale": "Each of ServiceStatusStrip, OverviewMetricsGrid, and OverviewCharts calls useDashboardRealtime() independently on /overview, opening multiple WebSocket subscriptions and duplicate 30s polling loops for the same dashboard aggregate; fix is to lift the hook to a shared provider/page-level parent.", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_realtime_status_badge_separate_socket_issue", "label": "RealtimeStatusBadge Separate Socket Issue", "file_type": "rationale", "rationale": "RealtimeStatusBadge opens its own socket only to show connection status instead of reusing shared realtime connection state; wasteful but not broken.", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_mislabeled_live_pages_issue", "label": "Pages Labeled Live But Not Truly Live Issue", "file_type": "rationale", "rationale": "traffic and health pages are server-rendered snapshots only and logs fetches once on mount; if realtime behavior is expected these should be connected to socket channels or polling, otherwise labeled as snapshots.", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_partial_push_update_issue", "label": "Dashboard WebSocket Partial Push Update Issue", "file_type": "rationale", "rationale": "useDashboardRealtime accepts dashboard_metrics pushes but only updates summary fields and derived series; timeline, distribution, and model metrics still depend on the polling path, so the dashboard is not fully push-complete.", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_threat_notifications_channel", "label": "threat_notifications channel", "file_type": "concept", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_session_logs_channel", "label": "session_logs channel", "file_type": "concept", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_blocked_ip_updates_channel", "label": "blocked_ip_updates channel", "file_type": "concept", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_realtime_transport_map_dashboard_metrics_channel", "label": "dashboard_metrics channel", "file_type": "concept", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "backend_first_fetch_db_fallback_pattern", "label": "Backend-First Fetch with DB Fallback Pattern", "file_type": "rationale", "rationale": "Initial page state pages (threats, sessions, blocked-ips) fetch from the backend first and fall back to local DB only if that fails, keeping a single predictable data path.", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_src_components_dashboard_realtime_status_badge_realtimestatusbadge", "label": "RealtimeStatusBadge", "file_type": "code", "source_file": "docs/realtime-transport-map.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_src_components_dashboard_globa