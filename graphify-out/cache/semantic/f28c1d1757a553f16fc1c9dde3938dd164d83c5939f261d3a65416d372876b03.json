{"nodes": [{"id": "docs_superpowers_plans_2026_06_30_hybrid_capture_processing_architecture", "label": "Hybrid Capture + Processing Architecture Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-06-30-hybrid-capture-processing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_hybrid_capture_processing_architecture", "label": "Hybrid Capture/Processing Architecture Pattern", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-06-30-hybrid-capture-processing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits SmartIDS into a capture process (minimal parse + IPC enqueue) and a processing process (session ownership, ML prediction, response policy) so packet ingestion stays responsive when ML/session work spikes; keeps session-state ownership in a single process to avoid cross-process flow-state corruption; keeps backend forwarding, alert publishing, and telemetry off the hot path via background threads; framed as a safer incremental upgrade than fully multiprocessing all packet workers."}, {"id": "packet_capture_runtime_capture_process_captureprocess", "label": "CaptureProcess (planned)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-30-hybrid-capture-processing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packet_capture_runtime_processing_process_processingprocess", "label": "ProcessingProcess (planned)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-30-hybrid-capture-processing-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packet_capture_runtime_ipc_contracts_build_packet_message", "label": "build_packet_message (planned